double processOrder({
  required String orderId,
  required double itemPrice,
  String? promoCode,
  double? deliveryFee,
}) {
  double finalDeliveryFee = deliveryFee ?? 500.0;
  double discount = (promoCode == 'SAVE10') ? itemPrice * 0.10 : 0.0;
  double total = itemPrice - discount + finalDeliveryFee;

  print('--- Order Summary ---');
  print('Order ID: $orderId');
  print('Item Price: ${itemPrice.toStringAsFixed(2)}₸');
  if (discount > 0) {
    print('Promo Code: $promoCode (10% off) -> -${discount.toStringAsFixed(2)}₸');
  }
  print('Delivery Fee: ${finalDeliveryFee.toStringAsFixed(2)}₸');
  print('Total: ${total.toStringAsFixed(2)}₸');
  print('----------------------');

  return total;
}

void main() {
  processOrder(orderId: 'ORD001', itemPrice: 10000.0, promoCode: 'SAVE10');
  processOrder(orderId: 'ORD002', itemPrice: 5000.0, deliveryFee: 0.0);
  processOrder(orderId: 'ORD003', itemPrice: 7500.0);
}
