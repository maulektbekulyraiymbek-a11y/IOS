      itemBuilder: (context, index) {
        final event = eventsList[index];
        return Card(
          margin: const EdgeInsets.only(bottom: 14),
          clipBehavior: Clip.antiAlias,
          child: InkWell(
            onTap: () => onOpen(event),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                EventPoster(event: event, height: 140),
                Padding(
                  padding: const EdgeInsets.all(12),
                  child: Row(
                    children: [
                      Expanded(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                        Text(event.category.toUpperCase(),
                            style: const TextStyle(fontSize: 10, color: Colors.blue)),
                        Text(event.title, style: const TextStyle(
                            fontWeight: FontWeight.bold, fontSize: 17)),
                        Text('${event.date}  ·  ${event.price}'),
                      ])),
                      IconButton(
                        icon: Icon(favoriteTitles.contains(event.title)
                            ? Icons.favorite : Icons.favorite_border, color: Colors.red),
                        onPressed: () => onFavorite(event),
                      ),
                    ],
                  ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }
}

class EventDetailScreen extends StatefulWidget {
