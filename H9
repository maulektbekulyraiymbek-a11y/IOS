class _HomeScreenState extends State<HomeScreen> {
  int tab = 0;
  final Set<String> favoriteTitles = {};

  void toggleFavorite(Event event) {
    setState(() {
      if (!favoriteTitles.add(event.title)) favoriteTitles.remove(event.title);
    });
  }

  void openDetails(Event event) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => EventDetailScreen(
          event: event,
          isFavorite: favoriteTitles.contains(event.title),
          onFavorite: () => toggleFavorite(event),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final saved = events.where((event) => favoriteTitles.contains(event.title)).toList();
    const tabNames = ['Catalog', 'Feed', 'Favorites', 'Profile'];

    return Scaffold(
      appBar: AppBar(
        title: Text('evently.  /  ${tabNames[tab]}'),
        actions: [
          // LAB 9: The badge is rebuilt on every CartProvider update.
          Consumer<CartProvider>(
            builder: (context, cart, child) => IconButton(
              tooltip: 'Open cart',
              onPressed: () {
                Navigator.push(context, MaterialPageRoute(builder: (_) => const CartScreen()));
              },
              icon: Stack(
                clipBehavior: Clip.none,
                children: [
                  const Icon(Icons.shopping_cart_outlined, size: 27),
                  if (cart.count > 0)
                    Positioned(
                      right: -10,
                      top: -10,
                      child: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 5, vertical: 2),
                        decoration: BoxDecoration(
                          color: Colors.red,
                          borderRadius: BorderRadius.circular(12),
                        ),
                        constraints: const BoxConstraints(minWidth: 18),
                        child: Text('${cart.count}', textAlign: TextAlign.center,
                            style: const TextStyle(color: Colors.white, fontSize: 11)),
                      ),
                    ),
                ],
              ),
            ),
          ),
          const SizedBox(width: 10),
        ],
      ),
      body: IndexedStack(
        index: tab,
        children: [
          const CatalogScreen(),
          EventList(eventsList: events, favoriteTitles: favoriteTitles,
              onFavorite: toggleFavorite, onOpen: openDetails),
          EventList(eventsList: saved, favoriteTitles: favoriteTitles,
              onFavorite: toggleFavorite, onOpen: openDetails),
          ProfileScreen(name: widget.name, email: widget.email, role: widget.role),
        ],
      ),
      bottomNavigationBar: BottomNavigationBar(
        type: BottomNavigationBarType.fixed,
        currentIndex: tab,
        onTap: (index) => setState(() => tab = index),
        items: const [
          BottomNavigationBarItem(icon: Icon(Icons.storefront_outlined), label: 'Catalog'),
          BottomNavigationBarItem(icon: Icon(Icons.event_outlined), label: 'Feed'),
          BottomNavigationBarItem(icon: Icon(Icons.favorite_border), label: 'Favorites'),
          BottomNavigationBarItem(icon: Icon(Icons.person_outline), label: 'Profile'),
        ],
      ),
    );
  }
}

