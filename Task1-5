bool isPrime(int n) {
  if (n < 2) return false;
  for (int i = 2; i * i <= n; i++) {
    if (n % i == 0) return false;
  }
  return true;
}

void main() {
  for (int n in [3, 6]) {
    print("$n -> ${isPrime(n) ? 'prime number' : 'not prime number'}");
  }
}





