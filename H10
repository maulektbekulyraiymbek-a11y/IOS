void main() => runApp(const CloudStoreApp());

class Product {
  final int id;
  final String title;
  final double price;
  final String description;
  final String category;
  final String imageUrl;
  final double rating;
  final int reviewCount;

  Product({
    required this.id,
    required this.title,
    required this.price,
    required this.description,
    required this.category,
    required this.imageUrl,
    required this.rating,
    required this.reviewCount,
  });

  factory Product.fromJson(Map<String, dynamic> json) {
    final rate = json['rating'];
    final ratingJson = rate is Map ? rate : <String, dynamic>{};
    double number(dynamic value) {
      if (value is num) return value.toDouble();
      return double.tryParse('$value') ?? 0.0;
    }

    return Product(
      id: (json['id'] as num?)?.toInt() ?? 0,
      title: json['title']?.toString() ?? 'Untitled',
      price: number(json['price']),
      description: json['description']?.toString() ?? 'No description',
      category: json['category']?.toString() ?? 'Other',
      imageUrl: json['image']?.toString() ?? '',
      rating: number(ratingJson['rate']),
      reviewCount: (ratingJson['count'] as num?)?.toInt() ?? 0,
    );
  }
}

class CloudStoreApp extends StatelessWidget {
  const CloudStoreApp({super.key});

  @override
