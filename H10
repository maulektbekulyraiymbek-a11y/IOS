class TalentPhoto extends StatelessWidget {
  final Specialist talent;
  final int index;
  final double? width;
  final double? height;

  const TalentPhoto({
    super.key,
    required this.talent,
    required this.index,
    this.width,
    this.height,
  });

  @override
  Widget build(BuildContext context) => SizedBox(
    height: height,
    width: width,
    child: Image.network(
      talent.photos[index],
      fit: BoxFit.cover,
      width: width,
      height: height,
      loadingBuilder: (context, child, progress) => progress == null
          ? child
          : ColoredBox(
        color: talent.accent.withValues(alpha: 0.10),
        child: const Center(child: CircularProgressIndicator(strokeWidth: 2)),
      ),
      errorBuilder: (_, __, ___) => ColoredBox(
        color: talent.accent.withValues(alpha: 0.14),
        child: Center(child: Icon(talent.icon, color: talent.accent, size: 52)),
      ),
    ),
  );
}

