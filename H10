class _TalentFeedScreenState extends State<TalentFeedScreen> {
  List<Product> products = [];
  bool isLoading = true;
  String? errorMessage;
  String category = 'Все';
  String search = '';
  bool clientMode = true;
  final searchController = TextEditingController();

  final categories = const [
    'Все', 'Ведущие', 'Модели', 'Хостес', 'Фото/видео',
    'DJ и музыка', 'Организация', 'Аниматоры', 'Шоу', 'Бьюти', 'Техника',
  ];

  @override
  void initState() {
    super.initState();
    fetchProducts();
  }

  @override
  void dispose() {
    searchController.dispose();
    super.dispose();
  }

  Future<void> fetchProducts({bool refresh = false}) async {
    if (!refresh && mounted) {
      setState(() {
        isLoading = true;
        errorMessage = null;
      });
    }

    try {
      final response = await http
          .get(Uri.parse('https://fakestoreapi.com/products'))
          .timeout(const Duration(seconds: 10));

      if (response.statusCode == 404) {
        throw Exception('404 — адрес API не найден');
      }
      if (response.statusCode >= 500) {
        throw Exception('Ошибка сервера: ${response.statusCode}');
      }
      if (response.statusCode != 200) {
        throw Exception('HTTP ${response.statusCode}');
      }

      final decoded = jsonDecode(response.body);
      if (decoded is! List) throw const FormatException('Ожидался JSON-список');
      final result = decoded
          .map((item) => Product.fromJson(item as Map<String, dynamic>))
          .toList();
      if (!mounted) return;
      setState(() {
        products = result;
        errorMessage = null;
        isLoading = false;
      });
    } on TimeoutException {
      if (!mounted) return;
      setState(() {
        isLoading = false;
        errorMessage = 'Истекло время ожидания (10 секунд).';
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        isLoading = false;
        errorMessage = 'Не удалось загрузить каталог.\n$e';
      });
    }
  }

